    <script>
        // --- 1. Typewriter Effect Logic ---
        const romanticMessage = `ถึง ทอฟฟี่ ที่รักที่สุดในโลก... 💖\n\nสุขสันต์วันเกิดนะครับ! ขอบคุณที่เกิดมา ขอบคุณที่เข้ามาทำให้ทุกๆ วันของชีวิตเค้ามีความหมายและเต็มไปด้วยความหวานเหมือนชื่อทอฟฟี่เลยนะ\n\nวันเกิดปีนี้ เค้าขอให้ทอฟฟี่มีความสุขมากๆ มีแต่รอยยิ้มที่สดใส น่ารักแบบนี้ไปนานๆ มีสุขภาพร่างกายแข็งแรง ประสบความสำเร็จในทุกๆ ความฝันที่ตั้งใจไว้นะครับ\n\nไม่ว่าจะเจอวันที่ดีหรือวันที่เหนื่อย ย้อนกลับมาตรงนี้จะมีเค้าคอยกอด คอยซัพพอร์ต และรักทอฟฟี่เสมอเลยนะ 💕`;

        let typeIdx = 0;
        function typeWriter() {
            if (typeIdx < romanticMessage.length) {
                const char = romanticMessage.charAt(typeIdx);
                document.getElementById("typewriterText").innerHTML += char === '\n' ? '<br>' : char;
                typeIdx++;
                setTimeout(typeWriter, 45);
            } else {
                document.getElementById("cursor").style.display = "none";
            }
        }

        // --- 2. Synthetic Web Audio Romantic Piano Melody ---
        let audioCtx = null;
        let isPlayingMusic = false;
        let synthInterval = null;

        function initAudio() {
            if (!audioCtx) {
                audioCtx = new (window.AudioContext || window.webkitAudioContext)();
            }
        }

        const notes = [261.63, 329.63, 392.00, 493.88, 523.25, 587.33, 659.25]; // C, E, G, B, C, D, E
        function playRomanticChord() {
            if (!audioCtx || audioCtx.state !== 'running') return;

            const osc = audioCtx.createOscillator();
            const gain = audioCtx.createGain();

            const randomNote = notes[Math.floor(Math.random() * notes.length)];
            osc.type = 'sine';
            osc.frequency.setValueAtTime(randomNote, audioCtx.currentTime);

            gain.gain.setValueAtTime(0.08, audioCtx.currentTime);
            gain.gain.exponentialRampToValueAtTime(0.0001, audioCtx.currentTime + 2.5);

            osc.connect(gain);
            gain.connect(audioCtx.destination);

            osc.start();
            osc.stop(audioCtx.currentTime + 2.5);
        }

        function toggleMusic() {
            initAudio();
            if (audioCtx.state === 'suspended') {
                audioCtx.resume();
            }

            const statusText = document.getElementById("musicStatus");
            const icon = document.getElementById("musicIcon");

            if (!isPlayingMusic) {
                isPlayingMusic = true;
                statusText.innerText = "กำลังเล่นเพลงรัก 🎶";
                icon.classList.add("note-float");
                synthInterval = setInterval(playRomanticChord, 800);
            } else {
                isPlayingMusic = false;
                statusText.innerText = "เปิดเพลงรัก 💖";
                icon.classList.remove("note-float");
                clearInterval(synthInterval);
            }
        }

        document.getElementById("musicToggle").addEventListener("click", toggleMusic);

        // --- 3. Interactive Envelope & Transition ---
        document.getElementById("envelope").addEventListener("click", function() {
            this.classList.add("open");
            triggerConfetti();

            // Auto play gentle ambient tone on open
            initAudio();
            if(!isPlayingMusic) toggleMusic();

            setTimeout(() => {
                const intro = document.getElementById("introScreen");
                const main = document.getElementById("mainContent");
                
                intro.style.opacity = "0";
                setTimeout(() => {
                    intro.style.display = "none";
                    main.classList.remove("opacity-0");
                    main.classList.add("opacity-100");
                    typeWriter();
                }, 700);
            }, 1200);
        });

        // --- 4. Confetti Explosion Helper ---
        function triggerConfetti() {
            if (typeof confetti === 'function') {
                confetti({
                    particleCount: 80,
                    spread: 70,
                    origin: { y: 0.6 },
                    colors: ['#ff758f', '#ffb3c1', '#ffe6eb', '#ff4d6d']
                });
            }
        }

        // --- 5. Blow Out Candle Action ---
        function blowCandle() {
            const flame = document.getElementById("flame");
            const secretWish = document.getElementById("secretWish");

            flame.style.display = "none"; // Extinguish flame
            triggerConfetti();

            secretWish.classLis
